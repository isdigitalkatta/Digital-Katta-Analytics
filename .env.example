# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=

# JWT_SECRET: Optional secret cryptographic key used to sign and verify user/demo JWT sessions.
# If omitted or < 32 characters, a secure fallback session secret is used automatically.
JWT_SECRET=

# NODE_ENV: Runtime environment ('development' | 'production').
NODE_ENV=

# GEMINI_MODEL: Optional Gemini model alias (e.g., 'gemini-3.1-flash-lite').
GEMINI_MODEL=

# GOOGLE_SERVICE_ACCOUNT_JSON: Complete Google Service Account JSON file contents (or base64 encoded) downloaded from Google Cloud Console.
GOOGLE_SERVICE_ACCOUNT_JSON=

# GOOGLE_SERVICE_ACCOUNT_EMAIL: Optional if full JSON is provided in GOOGLE_SERVICE_ACCOUNT_JSON. Required only if pasting raw private key alone.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# GOOGLE_LEADS_SPREADSHEET_ID: Google Spreadsheet ID or URL for 'Digital Katta - Leads (Unpaid Customers)'
GOOGLE_LEADS_SPREADSHEET_ID=

# GOOGLE_PAID_CUSTOMERS_SPREADSHEET_ID: Google Spreadsheet ID or URL for 'Digital Katta - Paid Customers'
GOOGLE_PAID_CUSTOMERS_SPREADSHEET_ID=

# GOOGLE_WORKSPACE_OWNER_EMAIL: Google Workspace email to share the spreadsheets with (default: isdigitalkatta@gmail.com)
GOOGLE_WORKSPACE_OWNER_EMAIL=isdigitalkatta@gmail.com

# ENABLE_MANDATORY_CUSTOMER_PROFILE: Feature flag for mandatory customer profile after non-demo login ('true' | 'false', defaults to 'true')
ENABLE_MANDATORY_CUSTOMER_PROFILE=true

# GOOGLE_CLIENT_ID: Optional Google OAuth 2.0 Client ID for Sign in with Google (from Google Cloud Console Credentials)
GOOGLE_CLIENT_ID=

# GOOGLE_CLIENT_SECRET: Optional Google OAuth 2.0 Client Secret for automated token exchange
GOOGLE_CLIENT_SECRET=

# BILLING_WEBHOOK_SECRET: Secret key required to mark leads as PAID via server-side webhook or staff authorization.
BILLING_WEBHOOK_SECRET=

# RAZORPAY_WEBHOOK_SECRET: Optional webhook secret for verifying incoming Razorpay HMAC signatures (x-razorpay-signature).
RAZORPAY_WEBHOOK_SECRET=

